# =============================================================================
# .gitignore — Files to exclude from version control
# =============================================================================

# --- Secrets (NEVER commit these) ---
.env

# --- Python virtual environment (recreatable via pip install -r requirements.txt) ---
venv/
.venv/

# --- Python bytecode cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg

# --- Databricks ---
.databricks/

# --- Pytest ---
.ini
pytest.ini

# --- Others ---
