# =============================================================================
# .env.example — Configuration Template for AI Research & Learning Copilot
# =============================================================================
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: The .env file contains secrets and should NEVER be committed
# to version control. It is listed in .gitignore for this reason.
#
# For Databricks deployment, these values are stored in Databricks Secret
# Scopes instead (see setup_secrets.py). The .env file is for LOCAL
# development only.
# =============================================================================


# ---------------------------------------------------------------------------
# Lakebase (Databricks-managed Postgres)
# ---------------------------------------------------------------------------
# Full Postgres connection URL. Get this from your Databricks workspace:
# SQL Warehouses > Lakebase > Connection Details
# Format: postgresql://role:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://your-role:your-password@your-host:5432/databricks_postgres?sslmode=require

# Secret scope config (used by deployed apps to fetch DATABASE_URL from secrets)
LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url


# ---------------------------------------------------------------------------
# OpenAlex API (Primary paper discovery)
# ---------------------------------------------------------------------------
# OpenAlex uses a "polite pool" — just include your email in requests.
# This gets you faster, more reliable responses vs. the anonymous pool.
# No formal API key needed for our usage level.
# Docs: https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL=your-email@example.com


# ---------------------------------------------------------------------------
# Semantic Scholar API (Paper enrichment — TLDRs, influence, recommendations)
# ---------------------------------------------------------------------------
# Free API key from: https://www.semanticscholar.org/product/api
# Provides 1 request/second (vs. 100 req/5min for unauthenticated)
SEMANTIC_SCHOLAR_API_KEY=your-s2-api-key-here

# Secret scope config for Databricks deployment
S2_SECRET_SCOPE=semantic-scholar
S2_SECRET_KEY=api-key


# ---------------------------------------------------------------------------
# OpenRouter (LLM for RAG summaries — same provider as Day 2)
# ---------------------------------------------------------------------------
# Free API key from: https://openrouter.ai/keys
# We use the free model tier for generating AI summaries from retrieved context.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Secret scope config for Databricks deployment
OPENROUTER_SECRET_SCOPE=openrouter
OPENROUTER_SECRET_KEY_NAME=api-key
