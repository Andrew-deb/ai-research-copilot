# =============================================================================
# .env.example — Copy to .env and fill in your values (local dev only)
# In Databricks deployment, all secrets are stored in secret scopes instead.
# =============================================================================

# Lakebase — get connection string from: Databricks workspace > SQL Warehouses > Lakebase
DATABASE_URL=postgresql://your-role:your-password@your-host:5432/databricks_postgres?sslmode=require

# OpenAlex — polite pool identification (no formal API key needed)
OPENALEX_EMAIL=your-email@example.com

# Semantic Scholar — from https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your-s2-api-key-here

# OpenRouter — from https://openrouter.ai/keys (free tier)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-oss-120b:free
