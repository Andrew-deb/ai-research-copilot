# =============================================================================
# .env.example — copy to .env and fill in your values (local development).
#
# On Databricks the pipeline and MCP server read secrets from secret scopes
# instead (see setup_secrets.py). On Render these become service environment
# variables; render.yaml marks the secret ones `sync: false` so they are typed
# into the dashboard rather than committed.
#
# Everything below is commented out at its DEFAULT value, except the secrets at
# the top, which have no useful default. Uncomment only what you want to change —
# an .env that restates every default is one you have to maintain twice.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Lakebase — Databricks > Compute > Database instances
DATABASE_URL=postgresql://your-role:your-password@your-host:5432/databricks_postgres?sslmode=require

# OpenAlex polite pool. Not a key — an identifying contact address, which earns
# higher, more reliable rate limits. Without it you are throttled as an anonymous
# client and the ingestion pipeline warns about it.
OPENALEX_EMAIL=your-email@example.com


# -----------------------------------------------------------------------------
# Optional API keys — each degrades a feature rather than breaking the app
# -----------------------------------------------------------------------------

# Semantic Scholar — https://www.semanticscholar.org/product/api
# Absent: enrichment still runs, unauthenticated, and hits 429s sooner.
SEMANTIC_SCHOLAR_API_KEY=your-s2-api-key-here

# OpenRouter — https://openrouter.ai/keys
# Absent: the RAG answer box hides itself instead of erroring.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OpenRouter retired the :free slug of openai/gpt-oss-120b (404: "unavailable
# for free"). This one is verified for both RAG synthesis and tool calling.
# Switch to the paid slug openai/gpt-oss-120b if free-tier throttling bites.
#OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

# Hugging Face read token — https://huggingface.co/settings/tokens
#   Settings > Access Tokens > Create new token > Type: Read. Shown once.
# Needed only when EMBEDDING_BACKEND=hf_api. The ingestion pipeline does NOT use
# it: that runs the model in-process on the cluster.
HF_API_TOKEN=hf_your-read-token-here


# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------

# local | production. `production` switches on Secure session cookies AND makes
# config refuse to boot if the dev bypass is on, the secret key is still the
# default, or Google credentials are missing. Leave it alone locally.
#APP_ENV=local

#FLASK_DEBUG=false

# Signs session cookies, so in production anyone knowing it could forge a login.
# Render generates one automatically; config refuses to start if the default
# below survives into production.
#FLASK_SECRET_KEY=dev-secret-change-in-production


# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------

# Resolves every request to DEV_USER_EMAIL without signing in.
#
# SET THIS TO false TO TEST THE ANONYMOUS VISITOR EXPERIENCE — it is the only
# switch needed; anonymous browsing is already on by default.
#
# Cannot be enabled when APP_ENV=production: the app raises at import rather than
# silently making every visitor the dev user.
#ALLOW_DEV_USER_BYPASS=true

# The address is a shared contract, not a preference. setup_db.py seeds it and
# mcp_server/middleware/request_context.py writes as it, so changing it here
# alone splits the identity in two — the agent saves into one library while the
# dashboard renders another, and existing work appears to vanish.
#DEV_USER_EMAIL=demo@research-copilot.dev
#DEV_USER_NAME=Demo Researcher

# Signed-out visitors can browse, search and ask a metered number of questions.
# Turning this off makes every page redirect to /login.
#ALLOW_ANONYMOUS_DEMO=true

#SESSION_LIFETIME_DAYS=14

# Google OAuth — console.cloud.google.com > Credentials > OAuth client ID > Web.
# The authorised redirect URI must match EXACTLY:
#   http://localhost:8080/auth/google/callback
#   https://<service>.onrender.com/auth/google/callback
# Required in production; without them nobody can sign in and the dev bypass is
# refused, so the app has no way to identify anyone.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Quotas — PLACEHOLDER VALUES
# -----------------------------------------------------------------------------
# Every number here is a development placeholder, deliberately stingy so that an
# un-calibrated deploy is restrictive rather than expensive. Production values
# come from the calibration step (plan 3.6), which measures what an operation
# actually consumes and works backwards from the providers' free allowances.
#
# Authentication raises the allowance. It never removes it: an authenticated user
# with a runaway script costs exactly as much as an anonymous one.

# Switch metering off entirely while working locally. The stingy defaults below
# will otherwise interrupt ordinary browsing after twenty searches.
#QUOTAS_ENABLED=true

#ANON_SEARCH_PER_DAY=20
#ANON_RAG_PER_DAY=3
#ANON_AGENT_PER_DAY=1

#USER_SEARCH_PER_DAY=200
#USER_RAG_PER_DAY=30
#USER_AGENT_PER_DAY=10

# Ceilings across ALL traffic, authenticated included — many well-behaved users
# cost as much as one abusive one. On a free tier these protect availability
# rather than money: exhausting a provider's daily allowance kills the feature
# until it resets, for everyone.
#GLOBAL_RAG_PER_DAY=200
#GLOBAL_AGENT_PER_DAY=50


# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------

# How the dashboard turns a query into a vector:
#   local  - sentence-transformers in-process. Needs torch (~2 GB image,
#            ~500 MB RAM), so it does not fit a small container.
#   hf_api - Hugging Face Inference API, the SAME nomic-ai/modernbert-embed-base
#            model. Verified identical: cos(hf_api, local) = 1.000000.
#   auto   - hf_api when HF_API_TOKEN is set, else local.
#EMBEDDING_BACKEND=auto

# Warm the backend in a background thread at boot, so the first search does not
# pay the cold start (~8 s on the hosted model). Defaults to true outside debug.
#EMBEDDING_PRELOAD=true

# Override only if Hugging Face changes the endpoint path.
#HF_EMBEDDING_URL=
#HF_TIMEOUT_SECONDS=30


# -----------------------------------------------------------------------------
# Database pool
# -----------------------------------------------------------------------------
# Per worker process. Render's free instance runs one worker with four threads,
# and Lakebase free tiers are stingy with connections — render.yaml sets 3 there.
#DB_POOL_MIN=1
#DB_POOL_MAX=8


# -----------------------------------------------------------------------------
# Databricks service auth — the research agent's MCP connection (Phase 3.4)
# -----------------------------------------------------------------------------
# The dashboard calls the MCP server as a SERVICE PRINCIPAL, server-side. The
# browser never holds a Databricks token, never calls the MCP server, and never
# learns its URL.
#
# Create the principal:
#   Settings > Identity and access > Service principals > Add service principal
#       name: render-dashboard
#       Workspace access ON, Databricks SQL and Consumer access OFF, Admin OFF
#   Open it > Secrets tab > Generate secret      (the secret is shown ONCE)
#   Compute > Apps > mcp-ai-copilot > Permissions > Grant access
#       render-dashboard -> Can use
#
# That last step is the one that grants calling rights. The service principal's
# own Permissions tab controls who may ADMINISTER the principal, which is a
# different thing and does not let anyone call the app.
#
# Absent: the research assistant reports itself unavailable. Search, RAG,
# collections and everything else keep working.

# Workspace URL, no trailing slash. Visible in the browser address bar inside the
# workspace, and in the OIDC redirect the app issues when opened unauthenticated.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# From the service principal's Secrets tab. The client id is also shown as
# "Application Id" on its Configurations tab.
DATABRICKS_CLIENT_ID=your-service-principal-application-id
DATABRICKS_CLIENT_SECRET=your-service-principal-oauth-secret

# The app URL with /mcp on the end — the protocol endpoint, not the app root.
# The root redirects to a login page; only /mcp speaks MCP.
MCP_SERVER_URL=https://your-mcp-app.aws.databricksapps.com/mcp
